# Copy this file to .env and fill in real values.
# NEVER commit .env, NEVER paste these values into a chat/AI session.

HIS_BASE_URL=https://paras.myhealthcare.life
HIS_REGISTER_PATH=/InventoryRegisters
HIS_USERNAME=
HIS_PASSWORD=

# Optional: where downloaded reports get saved
DOWNLOAD_DIR=./downloads

# Optional: set to "true" to watch the browser instead of running headless
# (useful the first time, while you fill in the selectors below)
HEADFUL=false
